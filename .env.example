# Copy to .env before starting: cp .env.example .env
# .env is gitignored, so local edits to it never reach git.

# grafana/otel-lgtm version, pinned for reproducibility.
# All-in-one OpenTelemetry backend: Collector + Prometheus + Tempo + Loki + Pyroscope + Grafana.
#   https://hub.docker.com/r/grafana/otel-lgtm/tags
LGTM_VERSION=0.37.0

# Grafana's built-in admin login for this dev-only stack.
# The defaults below are what the image ships with; change them if the port
# is reachable from anywhere but your own machine.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
